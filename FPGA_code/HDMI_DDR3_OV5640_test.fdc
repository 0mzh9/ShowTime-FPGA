define_attribute {p:cmos2_pwdn} {PAP_IO_NONE} {TRUE}



define_attribute {n:cmos2_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}


define_attribute {p:uart_rx} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:uart_rx} {PAP_IO_LOC} {B24}
define_attribute {p:uart_rx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_rx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {C24}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx} {PAP_IO_SLEW} {SLOW}
set_false_path -from [get_ports {uart_rx}]


create_generated_clock -add -name {pix720} -source [get_ports {sys_clk}] [get_pins {u_video_pll/clkout0}] -master_clock [get_clocks {sys_clk}] -multiply_by {77} -divide_by {28}
create_generated_clock -add -name {phase720} -source [get_ports {sys_clk}] [get_pins {u_video_pll/clkout3}] -master_clock [get_clocks {sys_clk}] -edges {1 2 3} -edge_shift {10.101 -1.683 -13.468}
create_generated_clock -name {hdmi720} -add -source [get_pins {u_video_pll/clkout3}] [get_ports {pix_clk}] -master_clock [get_clocks {phase720}] -divide_by {1}
set_output_delay -clock [get_clocks {hdmi720}] -add_delay -max 4.000 [get_ports {r_out[*] g_out[*] b_out[*] de_out hs_out vs_out}]
set_output_delay -clock [get_clocks {hdmi720}] -add_delay -min -1.000 [get_ports {r_out[*] g_out[*] b_out[*] de_out hs_out vs_out}]
set_clock_uncertainty -setup 0.300 [get_clocks {hdmi720}]
set_clock_uncertainty -hold 0.300 [get_clocks {hdmi720}]

set_clock_groups -name video_modes -physically_exclusive -group [get_clocks {pix_clk tx_phase_clk hdmi_tx_clk}] -group [get_clocks {pix720 phase720 hdmi720}]


set_clock_groups -name control_domain -asynchronous -group [get_clocks {sys_clk}]
set_clock_groups -name configuration_domain -asynchronous -group [get_clocks {cfg_clk}]
set_clock_groups -name camera_configuration_domain -asynchronous -group [get_clocks {clk_25M}]
set_clock_groups -name video_domain -asynchronous -group [get_clocks {pix_clk tx_phase_clk hdmi_tx_clk pix720 phase720 hdmi720}]
set_output_delay -clock [get_clocks {sys_clk}] -max 0 [get_ports {uart_tx}]
set_output_delay -clock [get_clocks {sys_clk}] -min 0 [get_ports {uart_tx}]


set_false_path -from [get_pins {u_video_pll/locked}]



define_attribute {p:eeprom_scl} {PAP_IO_DIRECTION} {INOUT}
define_attribute {p:eeprom_scl} {PAP_IO_LOC} {A23}
define_attribute {p:eeprom_scl} {PAP_IO_VCCIO} {3.3}
define_attribute {p:eeprom_scl} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:eeprom_scl} {PAP_IO_DRIVE} {4}
define_attribute {p:eeprom_scl} {PAP_IO_SLEW} {SLOW}
define_attribute {p:eeprom_sda} {PAP_IO_DIRECTION} {INOUT}
define_attribute {p:eeprom_sda} {PAP_IO_LOC} {A24}
define_attribute {p:eeprom_sda} {PAP_IO_VCCIO} {3.3}
define_attribute {p:eeprom_sda} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:eeprom_sda} {PAP_IO_DRIVE} {4}
define_attribute {p:eeprom_sda} {PAP_IO_SLEW} {SLOW}
set_false_path -from [get_ports {eeprom_scl eeprom_sda}]
set_output_delay -clock [get_clocks {sys_clk}] -max 0 [get_ports {eeprom_scl eeprom_sda}]
set_output_delay -clock [get_clocks {sys_clk}] -min 0 [get_ports {eeprom_scl eeprom_sda}]
